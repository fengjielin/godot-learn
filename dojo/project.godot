; Engine configuration file.
; Godot Dojo —— 2D 俯视角「游戏开发练功房」
;
; 这个文件由 Godot 编辑器维护，也可以手改。手改时注意保持这段格式。
; 学习要点：project.godot 就是整个项目的「总配置」，其中 Autoload 段决定了
; 哪些全局单例在游戏启动时被创建（顺序即列表顺序，从上到下）。

config_version=5

[application]

config/name="Godot Dojo"
config/description="2D 俯视角游戏开发练功房：中央枢纽 + 16 个必备能力练习站。"
run/main_scene="res://src/hub/hub.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://common/event_bus/EventBus.cs"
SaveSystem="*res://common/save/SaveSystem.cs"
AudioManager="*res://common/audio/AudioManager.cs"
UiTheme="*res://common/ui/UiTheme.cs"
ScreenFx="*res://common/fx/ScreenFx.cs"
DebugHud="*res://common/debug/DebugHud.cs"
SceneRouter="*res://src/game/SceneRouter.cs"
; 开发期工具：输入回放。不传 --dev-input=... 时完全不生效。
DevAutomation="*res://src/dev/DevAutomation.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="dojo"

[rendering]

anti_aliasing/quality/msaa_2d=1

[input]

; InputMap: editor equivalent is Project Settings -> Input Map.
; One action may have several events; "deadzone" applies to analog sticks.
; Station s02_input walks through these concepts.

